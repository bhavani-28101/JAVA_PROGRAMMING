class Solution {
    public int[][] merge(int[][] nums) {
        Arrays.sort(nums,(a,b)-> a[0]-b[0]);
        int temp1=nums[0][0];
        int temp2=nums[0][1];
        List<int []> res=new ArrayList<>();
        for(int i=1;i<nums.length;i++){
            if(temp2>=nums[i][0]){
                temp2=Math.max(temp2,nums[i][1]);
            }
            else{
                res.add(new int[]{temp1,temp2});
                temp1=nums[i][0];
                temp2=nums[i][1];
            }
        }
        res.add(new int []{temp1,temp2});
        return res.toArray(new int[res.size()][]);
    }
}
