class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        int l=0;
        int sum=0;
        int res=Integer.MAX_VALUE;
        for(int r=0;r<nums.length;r++){
            sum+=nums[r];
            while(sum>=target){
                res=Math.min(res,r-l+1);
                sum-=nums[l];
                l+=1;
            }
        }
        if(res!=Integer.MAX_VALUE){
            return res;
        }
        else{
            return 0;
        }
    }
}
