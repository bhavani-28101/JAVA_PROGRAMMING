class Solution {
    public int firstMissingPositive(int[] nums) {
        int i=0;
        int correctplace=0;
        int temp=0;
        while(i<nums.length){
            correctplace=nums[i]-1;
            if((1<=nums[i]) && (nums[i] <nums.length) && (nums[i]!=nums[correctplace])){
                temp=nums[i];
                nums[i]=nums[correctplace];
                nums[correctplace]=temp;
            }
            else{
                i+=1;
            }

        }
        for(int r=0;r<nums.length;r++){
            if(nums[r]!=r+1){
                return r+1;
            }
        }
        return nums.length+1;

    }
}
