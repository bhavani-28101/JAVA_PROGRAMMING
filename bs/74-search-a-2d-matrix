class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int low=0;
        int right=matrix.length-1;
        int mid=0;
        int n=matrix[0].length;
        while(low<=right){
            mid=low+(right-low)/2;
            if(target<matrix[mid][0]){
                right=mid-1;
            }
            else if(target>matrix[mid][n-1]){
                low=mid+1;
            }
            else{
                break;
            }

        }
        if(low>right){
            return false;
        }
        int m=(low+right)/2;
        int left=0;
        right=n-1;
        while(left<=right){
            mid=left+(right-left)/2;
            if(matrix[m][mid]==target){
                return true;
            }
            else if(matrix[m][mid]>target){
                right=mid-1;
            }
            else{
                left=mid+1;
            }
        }
        return false;

    }
}
