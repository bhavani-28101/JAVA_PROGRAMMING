class Solution {
    public int countSpecialIntegers(int[] nums) {

        int[] count = new int[101];
        int[] first = new int[101];
        int[] second = new int[101];
        int[] third = new int[101];

        for (int i = 0; i < nums.length; i++) {
            int x = nums[i];

            count[x]++;

            if (count[x] == 1) {
                first[x] = i;
            } 
            else if (count[x] == 2) {
                second[x] = i;
            } 
            else if (count[x] == 3) {
                third[x] = i;
            }
        }

        int ans = 0;

        for (int x = 1; x <= 100; x++) {

            if (count[x] == 3) {

                if (second[x] - first[x] == third[x] - second[x]) {
                    ans++;
                }
            }
        }

        return ans;
    }
}
