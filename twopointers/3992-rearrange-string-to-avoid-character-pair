class Solution {
    public String rearrangeString(String s, char x, char y) {
        int l=0;
        int r=s.length()-1;
        char[] arr=s.toCharArray();
        while(l<r){
            while(l<r && arr[l] !=x){
                l++;
            }
            while( l<r && arr[r] !=y){
                r-=1;
            }
            if(l<r){
                char temp=arr[l];
                arr[l]=arr[r];
                arr[r]=temp;
                l++;
                r-=1;
            }
        }
        return new String(arr);
    }
}
