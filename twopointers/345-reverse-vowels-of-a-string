class Solution {
    public String reverseVowels(String s) {
        HashSet<Character> vow=new HashSet<>();
        vow.add('a');
        vow.add('e');
        vow.add('i');
        vow.add('o');
        vow.add('u');
        vow.add('A');
        vow.add('E');
        vow.add('I');
        vow.add('U');
        vow.add('O');
        int left=0;
        int right=s.length()-1;
        char arr[]=s.toCharArray();
        while(left<right){
            if(!vow.contains(arr[left])){
                left+=1;
            }
            if(!vow.contains(arr[right])){
                right-=1;
            }
            while(left<right && vow.contains(arr[left]) && vow.contains(arr[right])){
                char temp=arr[left];
                arr[left]=arr[right];
                arr[right]=temp;
                left+=1;
                right-=1;
            }
      }
      return new String(arr);
    }
}
