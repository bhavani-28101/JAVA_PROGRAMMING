class Solution {
    public int[][] floodFill(int[][] image, int sr, int sc, int color) {
        int startColor = image[sr][sc];

        // If the starting color is already the new color
        if (startColor == color) {
            return image;
        }

        fill(image, sr, sc, color, startColor);

        return image;
    }

    public void fill(int[][] image, int sr, int sc, int color, int startColor) {

        // Boundary check
        if (sr < 0 || sr >= image.length ||
            sc < 0 || sc >= image[0].length) {
            return;
        }

        // If this cell is not the original color, don't fill it
        if (image[sr][sc] != startColor) {
            return;
        }

        // Change current cell
        image[sr][sc] = color;

        // Right
        fill(image, sr, sc + 1, color, startColor);

        // Left
        fill(image, sr, sc - 1, color, startColor);

        // Down
        fill(image, sr + 1, sc, color, startColor);

        // Up
        fill(image, sr - 1, sc, color, startColor);
    }
}
