class Solution {
    public int climbStairs(int n) {
        int[] memo =new int[n+1];
        return steps(n,memo);
    }
    public int steps(int n,int[] memo){
            if(n==1){
                return 1;}
            if(n==2){
                return 2;}
            if(memo[n] !=0){
                return memo[n];}
            memo[n]=steps(n-1,memo)+steps(n-2,memo);
            return memo[n];
    }
}
